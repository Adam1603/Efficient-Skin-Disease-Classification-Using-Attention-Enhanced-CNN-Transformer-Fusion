METADATA_CSV = DATA_ROOT / 'HAM10000_metadata.csv'
IMG_DIRS = [DATA_ROOT / 'HAM10000_images_part_1', DATA_ROOT / 'HAM10000_images_part_2']

def find_image_path(img_id, search_dirs):
    """Search for image_id in part_1 and part_2 folders."""
    for ext in ['.jpg', '.png', '.jpeg']:
        for d in search_dirs:
            if d.exists():
                p = d / (img_id + ext)
                if p.exists():
                    return p
    for d in search_dirs:
        if d.exists():
            for f in d.glob(img_id + '*'):
                if f.suffix.lower() in ['.jpg', '.jpeg', '.png']:
                    return f
    return None

def load_ham10000_metadata(csv_path, img_dirs):
    df = pd.read_csv(csv_path)
    if 'dx' not in df.columns:
        raise ValueError('Metadata must have "dx" column. Columns: %s' % list(df.columns))
    rows = []
    for _, r in df.iterrows():
        img_id = r.get('image_id', str(r.get('lesion_id', '')))
        p = find_image_path(img_id, img_dirs)
        if p is None:
            continue
        dx = r['dx'].strip().lower()
        if dx not in CLASS_TO_IDX:
            continue
        rows.append({'image_path': str(p), 'label': CLASS_TO_IDX[dx], 'dx': dx})
    return pd.DataFrame(rows)

if METADATA_CSV.exists():
    meta = load_ham10000_metadata(METADATA_CSV, IMG_DIRS)
    if len(meta) == 0:
        df = pd.read_csv(METADATA_CSV)
        meta = []
        for _, r in df.iterrows():
            img_id = r.get('image_id', str(r.get('lesion_id', '')))
            for d in IMG_DIRS:
                if not Path(d).exists():
                    continue
                for p in Path(d).rglob(img_id + '*'):
                    if p.suffix.lower() in ['.jpg', '.jpeg', '.png']:
                        dx = r.get('dx', 'nv').strip().lower()
                        if dx in CLASS_TO_IDX:
                            meta.append({'image_path': str(p), 'label': CLASS_TO_IDX[dx], 'dx': dx})
                        break
                else:
                    continue
                break
        meta = pd.DataFrame(meta)
    print('Loaded %d samples from HAM10000' % len(meta))
    print(meta['dx'].value_counts())
else:
    meta = None
    print('HAM10000 not found. Expected: HAM1000/HAM10000_metadata.csv, HAM1000/HAM10000_images_part_1/*.jpg, HAM1000/HAM10000_images_part_2/*.jpg')



# Dataset class and 70:30 train/test split
class HAM10000Dataset(Dataset):
    def __init__(self, dataframe, transform=None):
        self.data = dataframe.reset_index(drop=True)
        self.transform = transform

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        row = self.data.iloc[idx]
        img = Image.open(row['image_path']).convert('RGB')
        label = row['label']
        if self.transform:
            img = self.transform(img)
        return img, label

if meta is not None and len(meta) > 0:
    train_df, test_df = train_test_split(meta, test_size=1 - TRAIN_RATIO, stratify=meta['label'], random_state=RANDOM_SEED)
    train_df, val_df = train_test_split(train_df, test_size=VAL_RATIO, stratify=train_df['label'], random_state=RANDOM_SEED)
    # Oversampling: FULL balance (each class = max_count) for better accuracy on minorities
    USE_OVERSAMPLING = True
    if USE_OVERSAMPLING:
        counts = train_df['label'].value_counts()
        target = int(counts.max())   # Full balance: every class has same count as majority
        train_dfs = []
        for lbl in range(NUM_CLASSES):
            sub = train_df[train_df['label'] == lbl]
            n = len(sub)
            if n < target:
                extra = sub.sample(n=target - n, replace=True, random_state=RANDOM_SEED)
                sub = pd.concat([sub, extra], ignore_index=True)
            train_dfs.append(sub)
        train_df = pd.concat(train_dfs, ignore_index=True).sample(frac=1, random_state=RANDOM_SEED).reset_index(drop=True)
        print('Oversampled train: %d samples (full balance, %d per class)' % (len(train_df), target))
    train_ds = HAM10000Dataset(train_df, transform=train_transform)
    val_ds = HAM10000Dataset(val_df, transform=test_transform)
    test_ds = HAM10000Dataset(test_df, transform=test_transform)
    # For 5-crop TTA: resize only (no crop); use 128 when IMG_SIZE=96
    tta_sz = 256 if IMG_SIZE >= 224 else 160
    test_transform_256 = transforms.Compose([transforms.Resize(tta_sz, interpolation=interp), transforms.ToTensor(), transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])])
    test_ds_256 = HAM10000Dataset(test_df, transform=test_transform_256)
    use_gpu = torch.cuda.is_available()
    num_workers = 0   # 0 = avoids shared memory / Bus error with workers
    # Sampler: oversampling = balanced data; else use weighted sampler for imbalance
    train_labels = train_df['label'].values
    _, counts = np.unique(train_labels, return_counts=True)
    pin_mem = use_gpu and num_workers == 0
    if USE_OVERSAMPLING:
        train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=num_workers, pin_memory=pin_mem)
    else:
        class_weights = 1.0 / (counts + 1e-6)
        sample_weights = class_weights[train_labels]
        sampler = WeightedRandomSampler(sample_weights, len(sample_weights))
        train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, sampler=sampler, num_workers=num_workers, pin_memory=pin_mem)
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=num_workers, pin_memory=pin_mem)
    test_loader = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=num_workers, pin_memory=pin_mem)
    test_loader_256 = DataLoader(test_ds_256, batch_size=1, shuffle=False, num_workers=0)
    print('Train: %d, Val: %d, Test: %d' % (len(train_ds), len(val_ds), len(test_ds)))
else:
    train_loader = val_loader = test_loader = test_loader_256 = None


