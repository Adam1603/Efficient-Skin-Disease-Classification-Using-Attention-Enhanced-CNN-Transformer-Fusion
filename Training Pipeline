# Class weights: Effective Number of Samples (best for imbalanced) — weight = (1-beta)/(1-beta^n)
if train_loader is not None:
    all_labels = []
    for _, labels in train_loader:
        all_labels.extend(labels.tolist())
    _, counts = np.unique(all_labels, return_counts=True)
    beta = 0.9999   # Effective Number; smaller beta = stronger reweighting
    effective_num = 1.0 - np.power(beta, counts.astype(float))
    class_weights = (1.0 - beta) / (effective_num + 1e-8)
    class_weights = torch.tensor(class_weights, dtype=torch.float32)
    class_weights = class_weights / class_weights.sum() * NUM_CLASSES
    class_weights = class_weights.to(device)
else:
    class_weights = torch.ones(NUM_CLASSES).to(device)

# Focal Loss for imbalanced classes (helps focus on hard examples)
class FocalLoss(nn.Module):
    def __init__(self, weight=None, gamma=2.0, reduction='mean'):
        super().__init__()
        self.weight = weight
        self.gamma = gamma
        self.reduction = reduction

    def forward(self, logits, targets):
        ce = F.cross_entropy(logits, targets, weight=self.weight, reduction='none')
        pt = torch.exp(-ce)
        focal = ((1 - pt) ** self.gamma) * ce
        return focal.mean() if self.reduction == 'mean' else focal.sum()

if USE_FOCAL_LOSS:
    criterion = FocalLoss(weight=class_weights, gamma=FOCAL_GAMMA)
else:
    criterion = nn.CrossEntropyLoss(weight=class_weights, label_smoothing=LABEL_SMOOTHING)
