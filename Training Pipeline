ABLATION_REGISTRY = {
    'baseline_cnn': {'kind': 'resnet50'},
    'cnn_backbone_gap_only': {'kind': 'hybrid', 'use_cbam': False, 'use_transformer': False, 'use_fusion_refinement': False},
    'cnn_cbam_gap_only': {'kind': 'hybrid', 'use_cbam': True, 'use_transformer': False, 'use_fusion_refinement': False},
    'transformer_only': {'kind': 'transformer_only'},
    'cnn_transformer_no_attention': {'kind': 'hybrid', 'use_cbam': False, 'use_transformer': True, 'use_fusion_refinement': False},
    'cnn_transformer_with_attention': {'kind': 'hybrid', 'use_cbam': True, 'use_transformer': True, 'use_fusion_refinement': False},
    'proposed_with_fusion_refine': {'kind': 'hybrid', 'use_cbam': True, 'use_transformer': True, 'use_fusion_refinement': True},
    'proposed_no_fusion_refine': {'kind': 'hybrid', 'use_cbam': True, 'use_transformer': True, 'use_fusion_refinement': False},
}

class TransformerOnlySkin(nn.Module):
    """Manuscript baseline: Transformer-only — patch embedding from RGB, Transformer encoder, CLS classify (no ResNet)."""
    def __init__(self, num_classes=NUM_CLASSES, embed_dim=256, depth=4, heads=8, mlp_dim=1024, dropout=0.35,
                 patch_size=16, img_size=224):
        super().__init__()
        self.patch_embed = nn.Conv2d(3, embed_dim, kernel_size=patch_size, stride=patch_size)
        nb = H * W + 1
        self.cls_token = nn.Parameter(torch.randn(1, 1, embed_dim))
        self.pos_embed = nn.Parameter(torch.randn(1, nb, embed_dim) * 0.02)
        enc = nn.TransformerEncoderLayer(
            d_model=embed_dim, nhead=heads, dim_feedforward=mlp_dim,
            dropout=dropout, activation='relu', batch_first=True,
        )
        self.encoder = nn.TransformerEncoder(enc, num_layers=depth)
        self.norm = nn.LayerNorm(embed_dim)
        self.head = nn.Linear(embed_dim, num_classes)

    def forward(self, x):
        B = x.size(0)
        x = self.patch_embed(x)
        x = x.flatten(2).transpose(1, 2)
        cls = self.cls_token.expand(B, -1, -1)
        x = torch.cat([cls, x], dim=1) + self.pos_embed
        x = self.encoder(x)
        x = self.norm(x[:, 0])
        return self.head(x)


def build_ablation_model(name, dropout=None):
    """Build model for manuscript ablation `name` (see ABLATION_REGISTRY)."""
    d = dropout if dropout is not None else DROPOUT
    cfg = ABLATION_REGISTRY.get(name)
    if cfg is None:
        raise ValueError('Unknown ablation %r. Choose one of: %s' % (name, list(ABLATION_REGISTRY.keys())))
    kind = cfg['kind']
    if kind == 'resnet50':
        return ResNet50Classifier(num_classes=NUM_CLASSES, dropout=d)
    if kind == 'transformer_only':
        return TransformerOnlySkin(num_classes=NUM_CLASSES, dropout=d, mlp_dim=1024, depth=4, heads=8, patch_size=16, img_size=IMG_SIZE)
    if kind == 'hybrid':
        kw = {k: v for k, v in cfg.items() if k != 'kind'}
        return HybridResNetTransformer(
            num_classes=NUM_CLASSES, resnet_pretrained=True, embed_dim=256, transformer_depth=4,
            transformer_heads=8, transformer_mlp_dim=1024, transformer_dropout=d, head_dropout=d,
            use_cls_token=True, **kw,
        )
    raise ValueError(kind)


MEL_IDX = CLASS_NAMES.index('mel')  # melanoma — report recall (sensitivity) explicitly

def mcnemar_test(y_true, pred_a, pred_b):
    """McNemar on paired predictions (same test images). pred_a = model A, pred_b = model B."""
    y_true = np.asarray(y_true).ravel()
    pred_a = np.asarray(pred_a).ravel()
    pred_b = np.asarray(pred_b).ravel()
    # Discordant counts: A correct & B wrong vs A wrong & B correct
    n_aw_bx = int(np.sum((pred_a == y_true) & (pred_b != y_true)))
    n_ax_bw = int(np.sum((pred_a != y_true) & (pred_b == y_true)))
    nn = n_aw_bx + n_ax_bw
    stat = (abs(n_aw_bx - n_ax_bw) - 1) ** 2 / (nn + 1e-12) if nn > 0 else 0.0
    p_chi = float(1 - scipy_stats.chi2.cdf(stat, df=1)) if nn > 0 else 1.0
    p_binom = float(np.nan)
    try:
        p_binom = scipy_stats.binomtest(min(n_aw_bx, n_ax_bw), nn, 0.5, alternative='two-sided').pvalue
    except Exception:
        try:
            p_binom = float(scipy_stats.binom.sf(min(n_aw_bx, n_ax_bw) - 1, nn, 0.5) * 2)
            if p_binom > 1.0:
                p_binom = 1.0
        except Exception:
            pass
    return {
        'n_only_A_correct': n_aw_bx, 'n_only_B_correct': n_ax_bw,
        'chi2_stat': float(stat), 'p_chi2': p_chi, 'p_exact_two_sided': p_binom,
    }


def detailed_classification_metrics(y_true, y_pred, class_names=None):
    """Per-class + macro/weighted P/R/F1, accuracy, kappa; melanoma sensitivity highlighted."""
    names = class_names or CLASS_NAMES
    prec_pc, rec_pc, f1_pc, sup = precision_recall_fscore_support(
        y_true, y_pred, labels=list(range(len(names))), zero_division=0)
    prec_m, rec_m, f1_m, _ = precision_recall_fscore_support(
        y_true, y_pred, average='macro', zero_division=0)
    prec_w, rec_w, f1_w, _ = precision_recall_fscore_support(
        y_true, y_pred, average='weighted', zero_division=0)
    acc = float((np.asarray(y_true) == np.asarray(y_pred)).mean())
    kap = float(cohen_kappa_score(y_true, y_pred))
    out = {
        'accuracy': acc, 'cohen_kappa': kap,
        'macro_precision': prec_m, 'macro_recall': rec_m, 'macro_f1': f1_m,
        'weighted_precision': prec_w, 'weighted_recall': rec_w, 'weighted_f1': f1_w,
        'per_class': {names[i]: {'precision': float(prec_pc[i]), 'recall': float(rec_pc[i]),
                      'f1': float(f1_pc[i]), 'support': int(sup[i])} for i in range(len(names))},
        'melanoma_sensitivity_recall': float(rec_pc[MEL_IDX]),
    }
    return out


