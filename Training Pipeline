optimizer = torch.optim.Adam(model.parameters(), lr=LEARNING_RATE, betas=(0.9, 0.999), weight_decay=WEIGHT_DECAY)
if (USE_RESNET50_ACCURACY or USE_RESNET18_FAST or USE_RESNET34_FAST or USE_EFFICIENTNET) and train_loader is not None:
    scheduler = torch.optim.lr_scheduler.OneCycleLR(optimizer, max_lr=LEARNING_RATE, epochs=EPOCHS_SINGLE, steps_per_epoch=len(train_loader), pct_start=0.1)
else:
    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='max', factor=0.5, patience=LR_PATIENCE, verbose=True)
print('Model parameters:', sum(p.numel() for p in model.parameters()))



# Training loop — with early stopping, LR scheduler, best model checkpoint, AMP
if train_loader is None or val_loader is None:
    print('No train/val loader. Run data cells first.')
else:
    use_amp = USE_AMP and torch.cuda.is_available()
    if use_amp:
        print('Using AMP (mixed precision) for faster training')
    scaler = torch.cuda.amp.GradScaler() if use_amp else None
    history = {'train_loss': [], 'val_loss': [], 'train_acc': [], 'val_acc': []}
    n_epochs = EPOCHS_SINGLE
    best_val_acc = 0.0
    best_model_state = None
    patience_counter = 0
    WARMUP_EPOCHS = 5
    for epoch in range(n_epochs):
        # LR warmup (skip for OneCycleLR which has built-in warmup)
        if not (USE_RESNET50_ACCURACY or USE_RESNET18_FAST or USE_RESNET34_FAST or USE_EFFICIENTNET) and epoch < WARMUP_EPOCHS:
            for pg in optimizer.param_groups:
                pg['lr'] = LEARNING_RATE * (epoch + 1) / WARMUP_EPOCHS
        model.train()
        running_loss, correct, total = 0.0, 0, 0
        optimizer.zero_grad()
        for i, (imgs, labels) in enumerate(train_loader):
            imgs, labels = imgs.to(device, non_blocking=True), labels.to(device, non_blocking=True)
            # Mixup for regularization
            do_mixup = MIXUP_ALPHA > 0
            if do_mixup and imgs.size(0) > 1:
                lam = np.random.beta(MIXUP_ALPHA, MIXUP_ALPHA)
                idx = torch.randperm(imgs.size(0), device=imgs.device)
                imgs = lam * imgs + (1 - lam) * imgs[idx]
                labels_b = labels[idx]
            if use_amp:
                with torch.cuda.amp.autocast():
                    logits = model(imgs)
                    if do_mixup and imgs.size(0) > 1:
                        loss = (lam * criterion(logits, labels) + (1 - lam) * criterion(logits, labels_b)) / ACCUM_STEPS
                    else:
                        loss = criterion(logits, labels) / ACCUM_STEPS
                scaler.scale(loss).backward()
            else:
                logits = model(imgs)
                if do_mixup and imgs.size(0) > 1:
                    loss = (lam * criterion(logits, labels) + (1 - lam) * criterion(logits, labels_b)) / ACCUM_STEPS
                else:
                    loss = criterion(logits, labels) / ACCUM_STEPS
                loss.backward()
            running_loss += loss.item() * ACCUM_STEPS
            _, pred = logits.max(1)
            total += labels.size(0)
            correct += (pred == labels).sum().item()
            if (i + 1) % ACCUM_STEPS == 0 or (i + 1) == len(train_loader):
                if use_amp:
                    scaler.unscale_(optimizer)
                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
                if use_amp:
                    scaler.step(optimizer)
                    scaler.update()
                else:
                    optimizer.step()
                if USE_RESNET50_ACCURACY or USE_RESNET18_FAST or USE_RESNET34_FAST or USE_EFFICIENTNET:
                    scheduler.step()
                optimizer.zero_grad()
        train_loss = running_loss / len(train_loader)
        train_acc = 100.0 * correct / total
        history['train_loss'].append(train_loss)
        history['train_acc'].append(train_acc)
        # Validate every VAL_EVERY_N epochs (faster)
        if (epoch + 1) % VAL_EVERY_N == 0 or epoch == 0:
            model.eval()
            val_loss, correct_v, total_v = 0.0, 0, 0
            with torch.no_grad():
                for imgs, labels in val_loader:
                    imgs, labels = imgs.to(device, non_blocking=True), labels.to(device, non_blocking=True)
                    logits = model(imgs)
                    val_loss += criterion(logits, labels).item()
                    _, pred = logits.max(1)
                    total_v += labels.size(0)
                    correct_v += (pred == labels).sum().item()
            val_loss /= len(val_loader)
            val_acc = 100.0 * correct_v / total_v if total_v else 0.0
        else:
            val_acc = history['val_acc'][-1] if history['val_acc'] else 0.0
            val_loss = history['val_loss'][-1] if history['val_loss'] else 0.0
        history['val_loss'].append(val_loss)
        history['val_acc'].append(val_acc)
        did_validate = (epoch + 1) % VAL_EVERY_N == 0 or epoch == 0
        if epoch >= WARMUP_EPOCHS and not (USE_RESNET50_ACCURACY or USE_RESNET18_FAST or USE_RESNET34_FAST or USE_EFFICIENTNET):
            scheduler.step(val_acc)
        if did_validate and val_acc > best_val_acc:
            best_val_acc = val_acc
            best_model_state = {k: v.cpu().clone() for k, v in model.state_dict().items()}
            patience_counter = 0
        elif did_validate:
            patience_counter += 1
        if (epoch + 1) % 5 == 0 or epoch == 0:
            print('Epoch %d/%d — train loss: %.4f acc: %.2f%% | val loss: %.4f acc: %.2f%% (best: %.2f%%)' % (
                epoch + 1, n_epochs, train_loss, train_acc, val_loss, val_acc, best_val_acc))
        if patience_counter >= PATIENCE:
            print('Early stopping at epoch %d (no improvement for %d epochs)' % (epoch + 1, PATIENCE))
            break
    if best_model_state is not None:
        model.load_state_dict({k: v.to(device) for k, v in best_model_state.items()})
        print('Loaded best model (val_acc=%.2f%%)' % best_val_acc)
    print('Training completed.')



