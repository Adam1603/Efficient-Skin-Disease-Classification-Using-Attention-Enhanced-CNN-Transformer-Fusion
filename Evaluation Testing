def train_eval_seed_ablation(seed, ablation_name, train_loader, val_loader, test_loader, test_loader_256, max_epochs=None):
    """Train one model; return test accuracy (fraction), melanoma recall, preds, y_true."""
    use_tta = globals().get('USE_TTA', True)
    use_tta5 = globals().get('USE_TTA_5CROP', True)
    torch.manual_seed(seed)
    np.random.seed(seed)
    random.seed(seed)
    bab = globals().get('build_ablation_model')
    if bab is None or not callable(bab):
        raise RuntimeError('Run the ablation cell so build_ablation_model exists.')
    model_local = bab(ablation_name).to(device)
    all_labels = []
    for _, labels in train_loader:
        all_labels.extend(labels.tolist())
    _, counts = np.unique(all_labels, return_counts=True)
    beta = 0.9999
    effective_num = 1.0 - np.power(beta, counts.astype(float))
    cw = (1.0 - beta) / (effective_num + 1e-8)
    cw = torch.tensor(cw, dtype=torch.float32, device=device)
    cw = cw / cw.sum() * NUM_CLASSES
    crit = nn.CrossEntropyLoss(weight=cw, label_smoothing=LABEL_SMOOTHING)
    opt = torch.optim.Adam(model_local.parameters(), lr=LEARNING_RATE, betas=(0.9, 0.999), weight_decay=WEIGHT_DECAY)
    sched = torch.optim.lr_scheduler.ReduceLROnPlateau(opt, mode='max', factor=0.5, patience=LR_PATIENCE, verbose=False)
    use_amp = USE_AMP and torch.cuda.is_available()
    scaler = torch.cuda.amp.GradScaler() if use_amp else None
    best_val, best_state = 0.0, None
    patience_ct = 0
    n_epochs = max_epochs if max_epochs is not None else EPOCHS_SINGLE
    for epoch in range(n_epochs):
        model_local.train()
        for imgs, labels in train_loader:
            imgs, labels = imgs.to(device, non_blocking=True), labels.to(device, non_blocking=True)
            opt.zero_grad()
            if use_amp:
                with torch.cuda.amp.autocast():
                    logits = model_local(imgs)
                    loss = crit(logits, labels)
                scaler.scale(loss).backward()
                scaler.unscale_(opt)
                torch.nn.utils.clip_grad_norm_(model_local.parameters(), 1.0)
                scaler.step(opt)
                scaler.update()
            else:
                logits = model_local(imgs)
                loss = crit(logits, labels)
                loss.backward()
                torch.nn.utils.clip_grad_norm_(model_local.parameters(), 1.0)
                opt.step()
        model_local.eval()
        correct_v = total_v = 0
        with torch.no_grad():
            for imgs, labels in val_loader:
                imgs, labels = imgs.to(device), labels.to(device)
                _, pr = model_local(imgs).max(1)
                total_v += labels.size(0)
                correct_v += (pr == labels).sum().item()
        val_acc = 100.0 * correct_v / max(total_v, 1)
        sched.step(val_acc)
        if val_acc > best_val:
            best_val, best_state, patience_ct = val_acc, _clone_state(model_local), 0
        else:
            patience_ct += 1
        if (epoch + 1) % max(1, min(10, n_epochs)) == 0 or epoch == 0 or epoch + 1 == n_epochs:
            print('    [%s] ep %d/%d val %.2f%% best %.2f%%' % (ablation_name, epoch + 1, n_epochs, val_acc, best_val))
        if patience_ct >= PATIENCE:
            print('    [%s] early stop ep %d (best val %.2f%%)' % (ablation_name, epoch + 1, best_val))
            break
    if best_state is not None:
        model_local.load_state_dict({k: v.to(device) for k, v in best_state.items()})
    model_local.eval()
    all_probs, all_labels = [], []
    with torch.no_grad():
        if use_tta5 and test_loader_256 is not None:
            for (img, label) in test_loader_256:
                img = img.to(device).squeeze(0)
                c, h, w = img.shape
                crop_sz = IMG_SIZE
                crops = [img[:, (h-crop_sz)//2:(h+crop_sz)//2, (w-crop_sz)//2:(w+crop_sz)//2],
                         img[:, :crop_sz, :crop_sz], img[:, :crop_sz, -crop_sz:],
                         img[:, -crop_sz:, :crop_sz], img[:, -crop_sz:, -crop_sz:]]
                probs_list = []
                for cimg in crops:
                    cimg = cimg.unsqueeze(0)
                    p = F.softmax(model_local(cimg), dim=1)
                    if use_tta:
                        p = (p + F.softmax(model_local(torch.flip(cimg, dims=[3])), dim=1)) / 2
                    probs_list.append(p.cpu().numpy())
                all_probs.append(np.mean(probs_list, axis=0))
                all_labels.append(np.array([label.item()]))
        else:
            for imgs, labels in test_loader:
                imgs = imgs.to(device, non_blocking=True)
                logits = model_local(imgs)
                probs = F.softmax(logits, dim=1)
                if use_tta:
                    probs = (probs + F.softmax(model_local(torch.flip(imgs, dims=[3])), dim=1)) / 2
                all_probs.append(probs.cpu().numpy())
                all_labels.append(labels.numpy())
    yp = np.vstack(all_probs)
    yt = np.concatenate(all_labels)
    pred = np.argmax(yp, axis=1)
    acc = float((pred == yt).mean())
    mel_rec = detailed_classification_metrics(yt, pred)['melanoma_sensitivity_recall']
    del model_local
    if torch.cuda.is_available():
        torch.cuda.empty_cache()
    return acc, mel_rec, pred, yt

