# Grad-CAM: gradients of target score w.r.t. last conv feature map
# (Uses torch.autograd.grad — avoids feat.grad being None on intermediate tensors.)

def _gradcam_hook_module(model):
    if not hasattr(model, 'backbone'):
        return None
    bb = model.backbone
    if isinstance(bb, nn.Sequential):
        children = list(bb.children())
        return children[-1] if children else None
    if hasattr(bb, 'layer4'):
        return bb.layer4
    if hasattr(bb, 'features'):
        f = bb.features
        if isinstance(f, nn.Sequential) and len(f) > 0:
            return f[-1]
        return f
    return bb


def grad_cam_heatmap(model, img_tensor, target_class=None, device=None):
    if device is None:
        device = next(model.parameters()).device
    elif isinstance(device, str):
        device = torch.device(device)
    hook_mod = _gradcam_hook_module(model)
    if hook_mod is None:
        return None, None
    model.eval()
    if img_tensor.dim() == 3:
        img_tensor = img_tensor.unsqueeze(0)
    img_tensor = img_tensor.to(device).detach().clone().requires_grad_(True)
    activations = []

    def hook_fn(module, inp, out):
        activations.clear()
        activations.append(out)

    handle = hook_mod.register_forward_hook(hook_fn)
    logits = model(img_tensor)
    handle.remove()
    if not activations:
        return None, None
    feat = activations[0]
    if target_class is None:
        target_class = int(logits.argmax(dim=1).item())
    score = logits[0, target_class]
    grads = torch.autograd.grad(score, feat, retain_graph=False, allow_unused=True)[0]
    if grads is None:
        return None, target_class
    weights = grads.mean(dim=(2, 3), keepdim=True)
    cam = (weights * feat).sum(dim=1).squeeze(0)
    cam = F.relu(cam)
    cam = cam.detach()
    cam = cam / (cam.max() + 1e-8)
    cam = cam.unsqueeze(0).unsqueeze(0)
    cam = F.interpolate(cam, size=(IMG_SIZE, IMG_SIZE), mode='bilinear', align_corners=False)
    cam = cam.squeeze().cpu().numpy()
    return cam, target_class


