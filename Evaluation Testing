def _mcnemar_collect_probs(mdl):
    mdl.eval()
    all_probs, all_labels = [], []
    use_tta = globals().get('USE_TTA', True)
    use_tta5 = globals().get('USE_TTA_5CROP', True)
    with torch.no_grad():
        if use_tta5 and globals().get('test_loader_256', None) is not None:
            n_img = 0
            for (img, label) in test_loader_256:
                img = img.to(device).squeeze(0)
                c, h, w = img.shape
                crop_sz = IMG_SIZE
                crops = [img[:, (h - crop_sz) // 2:(h + crop_sz) // 2, (w - crop_sz) // 2:(w + crop_sz) // 2],
                         img[:, :crop_sz, :crop_sz], img[:, :crop_sz, -crop_sz:],
                         img[:, -crop_sz:, :crop_sz], img[:, -crop_sz:, -crop_sz:]]
                probs_list = []
                for cimg in crops:
                    cimg = cimg.unsqueeze(0)
                    p = F.softmax(mdl(cimg), dim=1)
                    if use_tta:
                        p = (p + F.softmax(mdl(torch.flip(cimg, dims=[3])), dim=1)) / 2
                    probs_list.append(p.cpu().numpy())
                all_probs.append(np.mean(probs_list, axis=0))
                all_labels.append(np.array([label.item()]))
                n_img += 1
                if n_img % 500 == 0:
                    print('  McNemar eval: %d / %d test images...' % (n_img, len(test_loader_256.dataset)))
        else:
            for imgs, labels in test_loader:
                imgs = imgs.to(device, non_blocking=True)
                probs = F.softmax(mdl(imgs), dim=1)
                if use_tta:
                    probs = (probs + F.softmax(mdl(torch.flip(imgs, dims=[3])), dim=1)) / 2
                all_probs.append(probs.cpu().numpy())
                all_labels.append(labels.numpy())
    return np.vstack(all_probs), np.concatenate(all_labels)


def _train_baseline_resnet_mcnemar(n_epochs, save_path=None):
    if 'build_ablation_model' in globals() and callable(globals()['build_ablation_model']):
        baseline = build_ablation_model('baseline_cnn').to(device)
    elif 'ResNet101Classifier' in globals():
        baseline = ResNet101Classifier(num_classes=NUM_CLASSES, dropout=DROPOUT).to(device)
    else:
        raise RuntimeError('Run the model cell (ResNet101Classifier) or ablation cell (build_ablation_model).')
    crit = nn.CrossEntropyLoss(weight=class_weights, label_smoothing=LABEL_SMOOTHING)
    opt = torch.optim.Adam(baseline.parameters(), lr=LEARNING_RATE, betas=(0.9, 0.999), weight_decay=WEIGHT_DECAY)
    sched = torch.optim.lr_scheduler.OneCycleLR(
        opt, max_lr=LEARNING_RATE, epochs=n_epochs, steps_per_epoch=len(train_loader), pct_start=0.1)
    use_amp = USE_AMP and torch.cuda.is_available()
    scaler = torch.cuda.amp.GradScaler() if use_amp else None
    best_val, best_state = 0.0, None
    patience_ct = 0
    _ttrain = _time_mcnemar.time()
    for epoch in range(n_epochs):
        baseline.train()
        for imgs, labels in train_loader:
            imgs, labels = imgs.to(device, non_blocking=True), labels.to(device, non_blocking=True)
            opt.zero_grad()
            if use_amp:
                with torch.cuda.amp.autocast():
                    loss = crit(baseline(imgs), labels)
                scaler.scale(loss).backward()
                scaler.unscale_(opt)
                torch.nn.utils.clip_grad_norm_(baseline.parameters(), max_norm=1.0)
                scaler.step(opt)
                scaler.update()
            else:
                loss = crit(baseline(imgs), labels)
                loss.backward()
                torch.nn.utils.clip_grad_norm_(baseline.parameters(), max_norm=1.0)
                opt.step()
            sched.step()
        baseline.eval()
        correct_v, total_v = 0, 0
        with torch.no_grad():
            for imgs, labels in val_loader:
                imgs, labels = imgs.to(device), labels.to(device)
                _, pred = baseline(imgs).max(1)
                total_v += labels.size(0)
                correct_v += (pred == labels).sum().item()
        val_acc = 100.0 * correct_v / max(total_v, 1)
        if val_acc > best_val:
            best_val = val_acc
            best_state = {k: v.cpu().clone() for k, v in baseline.state_dict().items()}
            patience_ct = 0
        else:
            patience_ct += 1
        if epoch == 0 or (epoch + 1) % max(1, MCNEMAR_LOG_EVERY) == 0 or epoch + 1 == n_epochs:
            print('  [McNemar baseline] epoch %d/%d | val %.2f%% | best %.2f%% | %.1f min elapsed' % (
                epoch + 1, n_epochs, val_acc, best_val, (_time_mcnemar.time() - _ttrain) / 60.0))
        if patience_ct >= PATIENCE:
            print('  McNemar baseline: early stop at epoch %d (best val %.2f%%)' % (epoch + 1, best_val))
            break
    if best_state is not None:
        baseline.load_state_dict({k: v.to(device) for k, v in best_state.items()})
    if save_path:
        torch.save(baseline.state_dict(), save_path)
        print('Saved baseline weights to', save_path)
    return baseline


