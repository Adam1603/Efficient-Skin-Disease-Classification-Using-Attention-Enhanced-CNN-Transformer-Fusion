# --- k-fold cross-validation + Friedman test on fold accuracies ---
from sklearn.model_selection import StratifiedKFold

RUN_KFOLD_ANALYSIS = True  # set False to skip
N_FOLDS = 5  
KFOLD_MAX_EPOCHS = 80  
KFOLD_MODEL_NAMES = ['baseline_cnn', 'cnn_transformer_with_attention']  # add more for Friedman (needs >= 3 models)

if not RUN_KFOLD_ANALYSIS:
    print('K-fold experiment is OFF (RUN_KFOLD_ANALYSIS=False).')
elif meta is None:
    print('K-fold skipped: meta is None — load HAM10000 data first.')
elif 'train_eval_seed_ablation' not in globals():
    print('K-fold skipped: run the multi-seed cell first (defines train_eval_seed_ablation).')
else:
    print('K-fold: %d folds | max %d epochs per model per fold | %s' % (N_FOLDS, KFOLD_MAX_EPOCHS, KFOLD_MODEL_NAMES))
    X_idx = np.arange(len(meta))
    y_lab = meta['label'].values
    kf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=RANDOM_SEED)
    fold_scores = {m: [] for m in KFOLD_MODEL_NAMES}
    for fold_id, (tr_idx, te_idx) in enumerate(kf.split(X_idx, y_lab)):
        print('--- Fold %d / %d ---' % (fold_id + 1, N_FOLDS))
        tr_meta = meta.iloc[tr_idx].reset_index(drop=True)
        te_meta = meta.iloc[te_idx].reset_index(drop=True)
        tr_df, va_df = train_test_split(tr_meta, test_size=VAL_RATIO, stratify=tr_meta['label'], random_state=RANDOM_SEED + fold_id)
        counts = tr_df['label'].value_counts()
        target = int(counts.max())
        train_dfs = []
        for lbl in range(NUM_CLASSES):
            sub = tr_df[tr_df['label'] == lbl]
            if len(sub) < target:
                sub = pd.concat([sub, sub.sample(n=target - len(sub), replace=True, random_state=RANDOM_SEED)], ignore_index=True)
            train_dfs.append(sub)
        tr_df = pd.concat(train_dfs, ignore_index=True).sample(frac=1, random_state=RANDOM_SEED).reset_index(drop=True)
        nw = 0
        pin_mem = torch.cuda.is_available()
        tr_ds = HAM10000Dataset(tr_df, transform=train_transform)
        va_ds = HAM10000Dataset(va_df, transform=test_transform)
        te_ds = HAM10000Dataset(te_meta, transform=test_transform)
        tta_sz = 256 if IMG_SIZE >= 224 else 160
        tt256 = transforms.Compose([transforms.Resize(tta_sz, interpolation=interp), transforms.ToTensor(), transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])])
        te_ds256 = HAM10000Dataset(te_meta, transform=tt256)
        tl = DataLoader(tr_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=nw, pin_memory=pin_mem and nw == 0)
        vl = DataLoader(va_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=nw, pin_memory=pin_mem and nw == 0)
        tel = DataLoader(te_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=nw, pin_memory=pin_mem and nw == 0)
        tel256 = DataLoader(te_ds256, batch_size=1, shuffle=False, num_workers=0)
        for mname in KFOLD_MODEL_NAMES:
            acc, mel, _, _ = train_eval_seed_ablation(RANDOM_SEED + fold_id, mname, tl, vl, tel, tel256, max_epochs=KFOLD_MAX_EPOCHS)
            fold_scores[mname].append(acc)
            print('  %s fold acc=%.4f' % (mname, acc))
    # Friedman: rows = folds, cols = models
    mat = np.column_stack([fold_scores[m] for m in KFOLD_MODEL_NAMES])
    if mat.shape[1] >= 3:
        stat_fr, p_fr = scipy_stats.friedmanchisquare(*[mat[:, j] for j in range(mat.shape[1])])
        print('Friedman test across models:', stat_fr, p_fr)
    else:
        print('Friedman needs >= 3 models; got %d. Use pairwise paired tests for two models.' % mat.shape[1])
    if mat.shape[1] == 2 and mat.shape[0] > 1:
        t_stat, p_t = scipy_stats.ttest_rel(mat[:, 0], mat[:, 1])
        print('Paired t-test on fold accuracies (%s vs %s): p=%.6f' % (KFOLD_MODEL_NAMES[0], KFOLD_MODEL_NAMES[1], p_t))
    print('=== K-fold block finished ===')





